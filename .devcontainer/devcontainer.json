{
  "name": "AI Editorial Studio",
  // Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "backend/app/main.py"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "updateContentCommand": "python -m pip install --user -r backend/requirements.txt && npm install --prefix frontend",
  "postAttachCommand": {
    "server": "npm run dev --prefix frontend -- --host 0.0.0.0 & uvicorn app.main:app --app-dir backend --host 0.0.0.0 --port 8000"
  },
  "portsAttributes": {
    "8000": {
      "label": "FastAPI backend",
      "onAutoForward": "notify"
    },
    "5173": {
      "label": "React frontend",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    8000,
    5173
  ]
}
