LINKEDIN_AUTHOR_URN=
TOKEN_ENCRYPTION_KEY=
PUBLISHING_WEB_USER=
PUBLISHING_WEB_PASSWORD=
PUBLISHING_UI_PASSWORD=

# PostgreSQL URL enables durable LangGraph checkpoints; publishing DB path stores idempotency + OAuth records.
DATABASE_URL=
PUBLISHING_DB_PATH=publishing.db

