# Local Ollama model selection and web research (backend only)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
TAVILY_API_KEY=

# Publishing providers (server-side only)
WORDPRESS_CLIENT_ID=
WORDPRESS_CLIENT_SECRET=
WORDPRESS_REDIRECT_URI=
WORDPRESS_SITE_ID=
WORDPRESS_SITE_URL=
DEV_API_KEY=

PRIMARY_BLOG_PLATFORM=wordpress
CANONICAL_URL=
LINKEDIN_API_VERSION=202608

# LinkedIn OAuth. Register LINKEDIN_REDIRECT_URI as an authorized redirect URL.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=

# Optional legacy/manual server secret; prefer OAuth endpoint and encrypted token storage.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
TOKEN_ENCRYPTION_KEY=
PUBLISHING_WEB_USER=
PUBLISHING_WEB_PASSWORD=
PUBLISHING_UI_PASSWORD=
COOKIE_SECURE=false
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
WORKFLOW_WORKERS=1

# Local SQLite file for durable LangGraph checkpoints, publication idempotency, and OAuth records.
PUBLISHING_DB_PATH=publishing.db

